+class TestTemplatedIdMetrics:
+    """Structural signal that closes the whole-string-entropy blind spot
+    for fixed-prefix + small varying suffix patterns (e.g. bookTitle7)."""
+
+    def test_book_title_style_is_templated(self):
+        ids = ["bookTitle7", "bookTitle38", "bookTitle17"]
+        m = MathCore.templated_id_metrics(ids)
+        assert m["common_prefix"] == "bookTitle"
+        assert m["prefix_length"] == 9
+        assert m["avg_suffix_entropy_bits"] is not None
+        assert m["avg_suffix_entropy_bits"] < 2.5  # short numeric suffixes
+        assert m["avg_fixed_fraction"] > 0.7
+        assert m["is_templated"] is True
+
+    def test_uuid_not_templated(self):
+        ids = [
+            "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
+            "f9e8d7c6-b5a4-3210-fedc-ba0987654321",
+            "11223344-5566-7788-99aa-bbccddeeff00",
+        ]
+        m = MathCore.templated_id_metrics(ids)
+        assert m["is_templated"] is False
+        # May share a short prefix by chance, but suffix entropy stays high
+        assert m["avg_suffix_entropy_bits"] is None or m["avg_suffix_entropy_bits"] > 3.0 or m["prefix_length"] < 3
+
+    def test_identical_strings(self):
+        ids = ["same", "same", "same"]
+        m = MathCore.templated_id_metrics(ids)
+        assert m["common_prefix"] == "same"
+        assert m["avg_suffix_entropy_bits"] == 0.0
+        assert m["is_templated"] is True
+
+    def test_no_common_prefix(self):
+        ids = ["alpha", "beta", "gamma"]
+        m = MathCore.templated_id_metrics(ids)
+        assert m["common_prefix"] == ""
+        assert m["prefix_length"] == 0
+        assert m["is_templated"] is False
+
+    def test_longest_common_prefix_helper(self):
+        assert MathCore.longest_common_prefix(["bookTitle7", "bookTitle38"]) == "bookTitle"
+        assert MathCore.longest_common_prefix(["abc", "abd", "abe"]) == "ab"
+        assert MathCore.longest_common_prefix(["x", "y"]) == ""
+        assert MathCore.longest_common_prefix([]) == ""
