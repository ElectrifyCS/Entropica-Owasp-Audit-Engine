+class TestTemplatedIdSignal:
+    """BOLA must now flag fixed-prefix + low-suffix-entropy patterns that
+    whole-string entropy alone previously missed."""
+
+    def test_book_title_pattern_triggers_templated(self):
+        import asyncio
+        from entropica_audit_engine.rules.bola import PredictableResourceIDRule
+
+        rule = PredictableResourceIDRule(entropy_threshold=3.0)
+        ids = ["bookTitle7", "bookTitle38", "bookTitle17", "bookTitle42"]
+        finding = asyncio.run(rule.execute("https://api.example.com/books/{id}", sample_ids=ids))
+        assert finding is not None
+        assert "templated_id" in finding.metrics["triggered_by"]
+        assert finding.metrics["common_prefix"] == "bookTitle"
+        assert finding.metrics["avg_suffix_entropy_bits"] < 3.0
+
+    def test_high_entropy_tokens_do_not_trigger_templated(self):
+        import asyncio
+        from entropica_audit_engine.rules.bola import PredictableResourceIDRule
+
+        rule = PredictableResourceIDRule()
+        ids = [
+            "a1b2c3d4e5f67890",
+            "f9e8d7c6b5a43210",
+            "1122334455667788",
+            "9988776655443322",
+        ]
+        finding = asyncio.run(rule.execute("https://api.example.com/tokens/{id}", sample_ids=ids))
+        # May or may not trigger on whole-string entropy depending on threshold,
+        # but must not claim the templated_id structural signal.
+        if finding is not None:
+            assert "templated_id" not in finding.metrics.get("triggered_by", [])
