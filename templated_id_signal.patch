@@ -126,6 +126,24 @@ def _sequential_clause(metrics: dict) -> Optional[str]:
 # ----------------------------------------------------------------------
 # Per-rule explainers
 # ----------------------------------------------------------------------
+def _templated_clause(metrics: dict) -> Optional[str]:
+    """Structural signal for fixed-prefix + low-entropy-suffix IDs."""
+    if "templated_id" not in metrics.get("triggered_by", []) and not metrics.get("is_templated"):
+        return None
+    prefix = metrics.get("common_prefix") or ""
+    suf_ent = metrics.get("avg_suffix_entropy_bits")
+    fixed = metrics.get("avg_fixed_fraction")
+    if not prefix or suf_ent is None:
+        return None
+    fixed_pct = f", ~{fixed * 100:.0f}% of each ID is the fixed prefix" if fixed is not None else ""
+    return (
+        f"IDs share a common prefix `{prefix}` (length {len(prefix)}) with low "
+        f"entropy on the varying suffix (\u2248 {suf_ent} bits){fixed_pct}. "
+        "This is a templated / structurally predictable pattern that whole-string "
+        "entropy alone can miss."
+    )
+
+
 def _explain_bola(finding: Finding, rate_rps: float) -> str:
     m = finding.metrics
     parts = []
