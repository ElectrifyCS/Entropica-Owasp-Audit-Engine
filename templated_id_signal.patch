--- a/entropica_audit_engine/core/math_core.py
+++ b/entropica_audit_engine/core/math_core.py
@@ -313,3 +313,116 @@ class MathCore:
         lower = max(0.0, point - half)
         upper = point + half
         return (point, lower, upper)
+
+    # ------------------------------------------------------------------
+    # 5. Structural / templated-ID signal (prefix + varying suffix)
+    # ------------------------------------------------------------------
+    @staticmethod
+    def longest_common_prefix(strings: Sequence[str]) -> str:
+        """
+        Longest common prefix of a sequence of strings.
+
+        Returns the empty string if the sequence is empty or the strings
+        share no common prefix.  Used as the structural signal that pure
+        per-character entropy misses: a fixed, predictable prefix (e.g.
+        "bookTitle") followed by a small varying suffix is highly
+        guessable even when whole-string entropy looks healthy.
+        """
+        if not strings:
+            return ""
+        # Normalise to str and drop empties for the comparison
+        strs = [str(s) for s in strings if str(s)]
+        if not strs:
+            return ""
+        prefix = strs[0]
+        for s in strs[1:]:
+            while not s.startswith(prefix) and prefix:
+                prefix = prefix[:-1]
+            if not prefix:
+                break
+        return prefix
+
+    @staticmethod
+    def templated_id_metrics(
+        ids: Sequence[Union[str, int]],
+        use_miller_madow: bool = True,
+        min_prefix_len: int = 3,
+    ) -> dict:
+        """
+        Detect templated / structurally predictable non-numeric IDs.
+
+        Motivation (real-data finding)
+        ------------------------------
+        Whole-string Shannon / Miller–Madow entropy treats a fixed
+        predictable prefix as character diversity.  Samples such as
+        bookTitle7, bookTitle38, bookTitle17 therefore score in the
+        "safe" range even though an attacker only needs to enumerate a
+        tiny numeric suffix.  This helper isolates the *varying* part:
+
+            1. Compute the longest common prefix (LCP) across the sample.
+            2. Measure entropy only on the suffixes after that prefix.
+            3. Report how large a fraction of each string the fixed
+               prefix occupies.
+
+        A low suffix entropy combined with a non-trivial prefix is a
+        strong structural signal of a templated, guessable ID scheme.
+
+        Returns a dict with (at minimum):
+            common_prefix, prefix_length, avg_suffix_entropy_bits,
+            avg_suffix_normalized_entropy, avg_fixed_fraction,
+            is_templated (bool heuristic), suffixes_preview.
+        """
+        str_ids = [str(s) for s in ids]
+        if len(str_ids) < 2:
+            return {
+                "common_prefix": "",
+                "prefix_length": 0,
+                "avg_suffix_entropy_bits": None,
+                "avg_suffix_normalized_entropy": None,
+                "avg_fixed_fraction": 0.0,
+                "is_templated": False,
+                "suffixes_preview": [],
+            }
+
+        prefix = MathCore.longest_common_prefix(str_ids)
+        plen = len(prefix)
+
+        suffixes = [s[plen:] for s in str_ids]
+        # Empty suffixes (identical strings) → treat as fully fixed / zero entropy
+        entropy_fn = (
+            MathCore.miller_madow_entropy if use_miller_madow else MathCore.shannon_entropy
+        )
+        suffix_entropies = []
+        norm_entropies = []
+        fixed_fractions = []
+        for s, suf in zip(str_ids, suffixes):
+            if not suf:
+                suffix_entropies.append(0.0)
+                norm_entropies.append(0.0)
+            else:
+                suffix_entropies.append(entropy_fn(suf))
+                norm_entropies.append(MathCore.normalized_entropy(suf))
+            fixed_fractions.append(plen / len(s) if len(s) > 0 else 0.0)
+
+        avg_suf_ent = sum(suffix_entropies) / len(suffix_entropies)
+        avg_norm = sum(norm_entropies) / len(norm_entropies)
+        avg_fixed = sum(fixed_fractions) / len(fixed_fractions)
+
+        # Heuristic: non-trivial shared prefix + low entropy on the
+        # varying part.  Thresholds are conservative; the rule layer
+        # can still apply its own cut-offs on the raw metrics.
+        is_templated = (
+            plen >= min_prefix_len
+            and avg_suf_ent < 3.0
+            and avg_fixed >= 0.3
+        )
+
+        return {
+            "common_prefix": prefix,
+            "prefix_length": plen,
+            "avg_suffix_entropy_bits": round(avg_suf_ent, 3),
+            "avg_suffix_normalized_entropy": round(avg_norm, 3),
+            "avg_fixed_fraction": round(avg_fixed, 3),
+            "is_templated": is_templated,
+            "suffixes_preview": suffixes[:8],
+        }
